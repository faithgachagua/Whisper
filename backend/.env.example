PORT=4000
NODE_ENV=development
# REQUIRED in production — use a long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
DATA_FILE=./data/db.json
# Where uploaded photos are stored (not publicly served; fetched with short-lived signed links)
UPLOAD_DIR=./data/uploads
# Demo accounts + sample posts (never enable in production)
SEED_DEMO=true
SEED_PASSWORD=Whisper#2026
# Demographic groups smaller than this are hidden from admin stats
SMALL_GROUP_THRESHOLD=5
